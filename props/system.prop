# Camera
camera.disable_zsl_mode=true
ro.product.mod_device=lmi_global

# Disable problematic camera features
persist.vendor.camera.anchorsync.disable=1
persist.vendor.camera.expose.aux=0

# Fix BufferQueue reconnection issues for MIUI Camera
ro.vendor.camera.close.queue.before.disconnect=true
persist.vendor.camera.close.queue=1
persist.vendor.camera.force.session.close=1

# CRITICAL - Increase ImageReader buffer limits
ro.media.xml_variant.codecs=_vendor
persist.vendor.camera.imagereader.maxImages=6
media.stagefright.thumbnail.prefer_hw_codecs=true

# Force ImageReader cleanup
persist.camera.imagereader.close=1
debug.camera.imagereader.close=true
debug.camera.imagereader.maxbuffers=6

# Limit concurrent ImageReader instances
persist.vendor.camera.imagereader.maxcount=3

# Aggressive buffer management
persist.vendor.camera.bufferqueue.timeout=1000
persist.vendor.camera.flush.enable=1
persist.vendor.camera.flush.buffer=1

# Reduce buffer counts to prevent exhaustion
ro.vendor.camera.preview.buffer.count=6
persist.vendor.camera.capture.buffer.count=6

# Disable resource-intensive features that leak buffers
persist.vendor.camera.reprocess.enable=0
persist.vendor.camera.imagecodec.disable=1

# Charger
ro.charger.enable_suspend=1

# Display
debug.gralloc.gfx_ubwc_disable=0
persist.vendor.color.matrix=2
ro.surface_flinger.max_frame_buffer_acquired_buffers=3

# IMS
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1

# IOP
vendor.iop.enable_prefetch_ofr=1
vendor.iop.enable_uxe=1

# RIL
persist.sys.fflag.override.settings_provider_model=false
persist.vendor.radio.report_codec=1
ril.subscription.types=NV,RUIM
ro.telephony.default_network=33,33

# Thermal
vendor.sys.thermal.data.path=/data/vendor/thermal/

# Vendor
ro.vendor.qti.va_aosp.support=1

# Better Ram
ro.config.fha_enable=true
ro.sys.fw.bg_apps_limit=32
ro.config.dha_cached_max=16
ro.config.dha_empty_max=42
ro.config.dha_empty_init=32
ro.config.dha_lmk_scale=0.545
ro.config.dha_th_rate=2.3
ro.config.sdha_apps_bg_max=64
ro.config.sdha_apps_bg_min=8

audio.offload.buffer.size.kb=32
audio.offload.gapless.enabled=true
